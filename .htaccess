RewriteEngine On

# Patient prep page lives on imreadytoscan.org (query string preserved)
RewriteRule ^prep\.html$ https://imreadytoscan.org/prep.html [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove trailing slash except for directories / root
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Serve clean URLs for folder-based pages
DirectoryIndex index.html

# Prevent directory listing
Options -Indexes

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
